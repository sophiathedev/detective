<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Detective" suffix=" · Detective" phx-no-format>{assigns[:page_title]}</.live_title>
    <PhoenixVite.Components.assets
      names={["js/app.js", "css/app.css"]}
      manifest={{:detective, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(DetectiveWeb.Endpoint)}
      to_url={fn path -> static_url(@conn, path) end}
    />
  </head>
  <body class="min-h-screen bg-white text-zinc-950 antialiased">
    <nav
      id="account-navigation"
      aria-label="Account"
      class="relative z-20 flex min-h-14 items-center justify-end gap-4 border-b border-white/10 bg-[#0b0d0e] px-4 text-sm text-stone-400 sm:px-6 lg:px-8"
    >
      <.link
        href={~p"/"}
        class="mr-auto font-semibold tracking-[0.18em] text-stone-100 transition hover:text-[#e06a5b]"
      >
        DETECTIVE
      </.link>
      <%= if @current_scope do %>
        <span class="hidden font-medium text-stone-200 sm:inline">
          {@current_scope.user.display_name}
        </span>
        <.link href={~p"/dashboard"} class="transition hover:text-[#e06a5b]">Dashboard</.link>
        <.link href={~p"/users/settings"} class="transition hover:text-[#e06a5b]">Settings</.link>
        <.link
          href={~p"/users/log-out"}
          method="delete"
          class="transition hover:text-[#e06a5b]"
        >
          Log out
        </.link>
      <% else %>
        <.link href={~p"/users/register"} class="transition hover:text-[#e06a5b]">Register</.link>
        <.link href={~p"/users/log-in"} class="transition hover:text-[#e06a5b]">Log in</.link>
      <% end %>
    </nav>
    {@inner_content}
  </body>
</html>
