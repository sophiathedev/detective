<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Detective" suffix=" · Detective" phx-no-format>{assigns[:page_title]}</.live_title>
    <PhoenixVite.Components.assets
      names={["js/app.js", "css/app.css"]}
      manifest={{:detective, "priv/static/.vite/manifest.json"}}
      dev_server={PhoenixVite.Components.has_vite_watcher?(DetectiveWeb.Endpoint)}
      to_url={fn path -> static_url(@conn, path) end}
    />
  </head>
  <body class="min-h-screen bg-[var(--noir-ebony-950)] font-sans text-stone-100 antialiased">
    <nav
      id="account-navigation"
      aria-label="Account"
      class="noir-wood-nav relative z-20 flex min-h-14 items-center justify-end gap-4 px-4 text-sm text-stone-300 sm:px-6 lg:px-8"
    >
      <.link
        href={~p"/"}
        class="mr-auto font-semibold tracking-[0.18em] text-stone-100 transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
      >
        DETECTIVE
      </.link>
      <%= if @current_scope do %>
        <span class="hidden font-medium text-stone-200 sm:inline">
          {@current_scope.user.display_name}
        </span>
        <.link
          href={~p"/dashboard"}
          class="transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
        >Dashboard</.link>
        <.link
          href={~p"/users/settings"}
          class="transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
        >Settings</.link>
        <.link
          href={~p"/users/log-out"}
          method="delete"
          class="transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
        >
          Log out
        </.link>
      <% else %>
        <.link
          href={~p"/users/register"}
          class="transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
        >Register</.link>
        <.link
          href={~p"/users/log-in"}
          class="transition hover:text-[var(--noir-gold-500)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--noir-focus)]"
        >Log in</.link>
      <% end %>
    </nav>
    {@inner_content}
  </body>
</html>
