<Layouts.flash_group flash={@flash} />

<main class="min-h-screen bg-zinc-50 px-6 py-16 sm:py-24">
  <section class="mx-auto max-w-5xl overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr]">
      <div class="px-6 py-12 sm:px-12 sm:py-16">
        <div class="flex items-center gap-3">
          <img src={~p"/images/logo.svg"} width="40" height="28" alt="Phoenix" />
          <span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">
            Phoenix v{Application.spec(:phoenix, :vsn)}
          </span>
        </div>

        <h1 class="mt-10 max-w-2xl text-4xl font-semibold tracking-tight text-zinc-950 sm:text-6xl">
          Detective is ready for its frontend.
        </h1>
        <p class="mt-6 max-w-xl text-base leading-7 text-zinc-600 sm:text-lg">
          Phoenix handles realtime application state. Tailwind CSS provides a clean,
          utility-first design foundation without component plugins.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="https://hexdocs.pm/phoenix/overview.html"
            class="inline-flex items-center rounded-lg bg-zinc-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-950"
          >
            Phoenix docs <span class="ml-2" aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="https://tailwindcss.com/docs"
            class="inline-flex items-center rounded-lg border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-800 transition hover:bg-zinc-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-500"
          >
            Tailwind docs
          </a>
        </div>
      </div>

      <div class="border-t border-zinc-200 bg-zinc-950 p-8 text-zinc-100 lg:border-l lg:border-t-0 sm:p-12">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-zinc-400">Stack</p>
        <dl class="mt-8 space-y-6">
          <div>
            <dt class="text-sm text-zinc-400">Backend</dt>
            <dd class="mt-1 text-xl font-semibold">Phoenix 1.8</dd>
          </div>
          <div>
            <dt class="text-sm text-zinc-400">Styling</dt>
            <dd class="mt-1 text-xl font-semibold">Tailwind CSS 4</dd>
          </div>
          <div>
            <dt class="text-sm text-zinc-400">UI components</dt>
            <dd class="mt-1 text-xl font-semibold">Tailwind utilities</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</main>
